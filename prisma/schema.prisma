  allow_cm_posting_to                String?
  updated_at                         String?
  updated_by                         String?
  bank_charges_account               gl_account?   @relation("cms_bank_charges", fields: [bank_charges_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank_interest_income_account       gl_account?   @relation("cms_bank_interest", fields: [bank_interest_income_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  default_receipt_bank_account       bank_account? @relation(fields: [default_receipt_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// Business Central Table 274 "Bank Acc. Reconciliation Line".
model bank_rec_line {
  id                           Int                        @id @default(autoincrement())
  bank_reconciliation_id       Int
  line_no                      Int
  /// 'Bank Account Ledger Entry' | 'G/L Adjustment'
  type                         String                     @default("Bank Account Ledger Entry")
  transaction_date             String?
  document_no                  String?
  description                  String?
  statement_amount             BigInt                     @default(0)
  applied_amount               BigInt                     @default(0)
  bank_account_ledger_entry_id Int?
  gl_account_id                Int?
  applied                      Int                        @default(0)
  bank_reconciliation          bank_reconciliation        @relation(fields: [bank_reconciliation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bank_account_ledger_entry    bank_account_ledger_entry? @relation(fields: [bank_account_ledger_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gl_account                   gl_account?                @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([bank_reconciliation_id, line_no], map: "bank_rec_line_recon_lineno_key")
}

/// AL Table 52203423 "Receipt Header" — a maker-checker cash-in document.
model receipt_header {
  id                    Int            @id @default(autoincrement())
  no                    String         @unique
  /// 'Employee' | 'Customer' | 'Vendor' | 'G/L Account' | 'Bank Account' — AL's Receipt Type, which
  /// also fixes what every line on the receipt may be posted to.
  receipt_type          String         @default("G/L Account")
  posting_date          String         @default("")
  bank_account_id       Int
  bank_account_name     String?
  pay_mode_code         String?
  external_document_no  String?
  manual_receipt_no     String?
  description           String?
  currency_code         String         @default("KES")
  currency_factor       Float          @default(1)
  global_dimension_1_id Int?
  global_dimension_2_id Int?
  amount                BigInt         @default(0)
  approval_limit        BigInt         @default(0)
  status                String         @default("Open")
  posted                Boolean        @default(false)
  decision_reason       String?
  journal_id            Int?
  created_at            String?
  created_by            String?
  posted_at             String?
  posted_by             String?
  /// AL "Received Amount" — what the cashier counted. Checked against the sum of the lines before
  /// the receipt may be submitted, so a miskeyed line cannot post.
  received_amount       BigInt         @default(0)
  /// The Employee receipt type: money received from a member of staff.
  employee_id           Int?
  bank_account          bank_account   @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee              employee?      @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipt_line          receipt_line[]

  @@index([status], map: "ix_receipt_header_status")
  @@index([created_by], map: "ix_receipt_header_created_by")
}

model receipt_line {
  id                    Int            @id @default(autoincrement())
  receipt_header_id     Int
  line_no               Int
  line_type             String         @default("G/L Account")
  account_no            String?
  account_name          String?
  description           String?
  amount                BigInt         @default(0)
  applies_to_doc_no     String?
  global_dimension_1_id Int?
  global_dimension_2_id Int?
  /// AL's "Product Posting Type", which is what decides
  /// whether a document no. is required on the line.
  /// The balances as quoted when the line was captured, printed on the receipt so the
  /// payer can see what was owed before their payment.
  receipt_header        receipt_header @relation(fields: [receipt_header_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([receipt_header_id, line_no], map: "receipt_line_header_lineno_key")
}

model posted_receipt {
  id                   Int                   @id @default(autoincrement())
  no                   String                @unique
  receipt_no           String
  receipt_type         String
  bank_account_id      Int
  bank_account_name    String?
  pay_mode_code        String?
  external_document_no String?
  manual_receipt_no    String?
  description          String?
  currency_code        String                @default("KES")
  currency_factor      Float                 @default(1)
  posting_date         String
  amount               BigInt                @default(0)
  journal_id           Int?
  created_at           String?
  created_by           String?
  employee_id          Int?
  bank_account         bank_account          @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  posted_receipt_line  posted_receipt_line[]

  @@index([receipt_no], map: "ix_posted_receipt_receipt_no")
}

model posted_receipt_line {
  id                Int            @id @default(autoincrement())
  posted_receipt_id Int
  line_no           Int
  line_type         String
  account_no        String?
  account_name      String?
  description       String?
  amount            BigInt         @default(0)
  applies_to_doc_no String?
  posted_receipt    posted_receipt @relation(fields: [posted_receipt_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([posted_receipt_id], map: "ix_prl_doc")
}

/// AL Table 52203439 "Payment Voucher" — a maker-checker cash-out document.
model payment_voucher_header {
  id                       Int                    @id @default(autoincrement())
  no                       String                 @unique
  date                     String
  /// AL's Payment Type: 'RTGS/SWIFT' | 'Supplier Payment' | 'Customer Refund'
  /// | 'Bank Transfer' | 'Direct Expensing' | 'Payroll Settlement' | 'Remittance'. It fixes what
  /// every line on the voucher may pay, the way the AL relates Account No per Payment Type.
  pv_type                  String?
  pay_mode_code            String?
  cheque_no                String?
  cheque_date              String?
  cheque_received_by       String?
  paying_bank_account_id   Int
  currency_code            String                 @default("KES")
  currency_factor          Float                  @default(1)
  description              String?
  payee_name               String?
  payee_external_bank_code String?
  payee_bank_branch_code   String?
  payee_account_no         String?
  global_dimension_1_id    Int?
  global_dimension_2_id    Int?
  total_amount             BigInt                 @default(0)
  approval_limit           BigInt                 @default(0)
  status                   String                 @default("Open")
  posted                   Boolean                @default(false)
  decision_reason          String?
  prepared_by              String?
  journal_id               Int?
  created_at               String?
  created_by               String?
  posted_at                String?
  posted_by                String?
  /// The Employee Payment voucher type: money paid out to a member of staff.
  employee_id              Int?
  paying_bank_account      bank_account           @relation(fields: [paying_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee                 employee?              @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_voucher_line     payment_voucher_line[]

  @@index([status], map: "ix_pvh_status")
  @@index([created_by], map: "ix_pvh_created_by")
  @@index([cheque_no], map: "ix_pvh_cheque_no")
}

model payment_voucher_line {
  id                          Int                    @id @default(autoincrement())
  payment_voucher_header_id   Int
  line_no                     Int
  line_type                   String                 @default("G/L Account")
  account_no                  String?
  account_name                String?
  description                 String?
  amount                      BigInt                 @default(0)
  applies_to_doc_no           String?
  vat_prod_posting_group_code String?
  wht_code_one                String?
  wht_code_two                String?
  vat_amount                  BigInt                 @default(0)
  wht_amount_one              BigInt                 @default(0)
  wht_amount_two              BigInt                 @default(0)
  wht_base                    BigInt                 @default(0)
  net_amount                  BigInt                 @default(0)
  purchase_invoice_amount     BigInt                 @default(0)
  global_dimension_1_id       Int?
  global_dimension_2_id       Int?
  /// AL "Available Balance": balance less holds less the product's minimum balance, floored at
  /// zero. Snapshotted when the line is captured and re-checked at posting.
  payment_voucher_header      payment_voucher_header @relation(fields: [payment_voucher_header_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([payment_voucher_header_id, line_no], map: "payment_voucher_line_header_lineno_key")
}

model posted_payment_voucher {
  id                          Int                           @id @default(autoincrement())
  no                          String                        @unique
  pv_no                       String
  date                        String
  pay_mode_code               String?
  cheque_no                   String?
  cheque_date                 String?
  cheque_received_by          String?
  paying_bank_account_id      Int
  currency_code               String                        @default("KES")
  currency_factor             Float                         @default(1)
  description                 String?
  payee_name                  String?
  payee_external_bank_code    String?
  payee_bank_branch_code      String?
  payee_account_no            String?
  posting_date                String
  total_amount                BigInt                        @default(0)
  journal_id                  Int?
  prepared_by                 String?
  approved_by                 String?
  created_at                  String?
  created_by                  String?
  /// The Payment Type the voucher was raised under — the printout varies by it.
  pv_type                     String?
  employee_id                 Int?
  paying_bank_account         bank_account                  @relation(fields: [paying_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  posted_payment_voucher_line posted_payment_voucher_line[]

  @@index([pv_no], map: "ix_ppv_pv_no")
}

model posted_payment_voucher_line {
  id                          Int                    @id @default(autoincrement())
  posted_payment_voucher_id   Int
  line_no                     Int
  line_type                   String
  account_no                  String?
  account_name                String?
  description                 String?
  amount                      BigInt                 @default(0)
  applies_to_doc_no           String?
  vat_prod_posting_group_code String?
  wht_code_one                String?
  wht_code_two                String?
  vat_amount                  BigInt                 @default(0)
  wht_amount_one              BigInt                 @default(0)
  wht_amount_two              BigInt                 @default(0)
  wht_base                    BigInt                 @default(0)
  net_amount                  BigInt                 @default(0)
  posted_payment_voucher      posted_payment_voucher @relation(fields: [posted_payment_voucher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([posted_payment_voucher_id], map: "ix_ppvl_doc")
