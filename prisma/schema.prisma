}

/// Business Central Table 254 "VAT Entry" — one row per VATable / withholding posting.
model vat_entry {
  id                          Int     @id @default(autoincrement())
  posting_date                String
  document_type               String  @default("")
  document_no                 String
  /// 'Purchase' | 'Settlement'
