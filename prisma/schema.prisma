  vat_prod_posting_group_code String?
  vat_pct                     Float   @default(0)
  base                        BigInt  @default(0)
  amount                      BigInt  @default(0)
  base_fcy                    BigInt  @default(0)
  amount_fcy                  BigInt  @default(0)
  currency_code               String  @default("KES")
  currency_factor             Float   @default(1)
  bill_to_pay_to_no           String?
  vendor_pin                  String?
  wht_certificate_no          String?
  journal_id                  Int?
  source_type                 String?
  source_id                   Int?
  closed                      Int     @default(0)
  created_at                  String?

