/// Business Central Table 25 "Vendor Ledger Entry" — the vendor subledger. An Invoice is
/// positive (the payable owed), a Payment negative — the same sign convention Receivables uses.
model vendor_ledger_entry {
  id                           Int                            @id @default(autoincrement())
  vendor_id                    Int
  posting_date                 String
  /// 'Invoice' | 'Payment' | 'Credit Memo' | 'Finance Charge Memo' | 'Refund'
  document_type                String
  document_no                  String
