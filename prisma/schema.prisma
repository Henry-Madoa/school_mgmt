/// Business Central Table 333 "Column Layout" — one column of a Financial Report: which period it
/// measures (or a formula over the other columns), how it rounds, and when it is shown.
model column_layout {
  id                      Int                @id @default(autoincrement())
  column_layout_name_id   Int
  line_no                 Int                @default(0)
  column_no               String             @default("")
  column_header           String             @default("")
  /// NET_CHANGE | BALANCE_AT_DATE | BEGINNING_BALANCE | YEAR_TO_DATE | ENTIRE_FISCAL_YEAR | FORMULA
  column_type             String             @default("NET_CHANGE")
  /// ENTRIES | BUDGET_ENTRIES (read the budget named in budget_name — lib/glBudgets.ts)
  ledger_entry_type       String             @default("ENTRIES")
  budget_name             String?
  /// NET_AMOUNT | DEBIT_AMOUNT | CREDIT_AMOUNT
  amount_type             String             @default("NET_AMOUNT")
  formula                 String             @default("")
  /// Business Central "DateFormula" applied to the column window, e.g. -1Y (see lib/dateFormula.ts)
  comparison_date_formula String             @default("")
  /// ALWAYS | NEVER | WHEN_POSITIVE | WHEN_NEGATIVE
  show                    String             @default("ALWAYS")
  /// NONE | 1 | 1000 | 1000000
  rounding_factor         String             @default("NONE")
  created_at              String?
  created_by              String?
  column_layout_name      column_layout_name @relation(fields: [column_layout_name_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([column_layout_name_id], map: "ix_column_layout_name")
