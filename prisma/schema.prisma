/// A maker-checker Payment Journal batch (BC General Journal, vendor payment lines).
/**
 * ============================================================================================
 * Cash Management (Business Central) + multi-currency. See lib/bankMgmt.ts, lib/cashMgmtSetup.ts,
 * lib/receipts.ts, lib/paymentVouchers.ts.
 * ==========================================================================================
 */

/// Business Central Table 4 "Currency". KES is the base (is_base = 1); a non-base currency needs
/// at least one currency_exchange_rate row before it can be used.
model currency {
  id                           Int                      @id @default(autoincrement())
  code                         String                   @unique
  description                  String
  symbol                       String?
  iso_numeric_code             String?
  is_base                      Int                      @default(0)
  amount_rounding_precision    BigInt                   @default(1)
  invoice_rounding_precision   BigInt                   @default(0)
  realized_gains_account_id    Int?
  realized_losses_account_id   Int?
  unrealized_gains_account_id  Int?
  unrealized_losses_account_id Int?
  residual_gains_account_id    Int?
  residual_losses_account_id   Int?
  blocked                      Int                      @default(0)
  created_at                   String?
  created_by                   String?
  realized_gains_account       gl_account?              @relation("currency_realized_gains", fields: [realized_gains_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  realized_losses_account      gl_account?              @relation("currency_realized_losses", fields: [realized_losses_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unrealized_gains_account     gl_account?              @relation("currency_unrealized_gains", fields: [unrealized_gains_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unrealized_losses_account    gl_account?              @relation("currency_unrealized_losses", fields: [unrealized_losses_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  residual_gains_account       gl_account?              @relation("currency_residual_gains", fields: [residual_gains_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  residual_losses_account      gl_account?              @relation("currency_residual_losses", fields: [residual_losses_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency_exchange_rate       currency_exchange_rate[]
}

/// Business Central Table 330 "Currency Exchange Rate".
model currency_exchange_rate {
  id                          Int      @id @default(autoincrement())
  currency_code               String
  starting_date               String
  exchange_rate_amount        Float    @default(1)
  relational_exch_rate_amount Float    @default(1)
  created_at                  String?
  created_by                  String?
  currency                    currency @relation(fields: [currency_code], references: [code], onDelete: Cascade, onUpdate: NoAction)

  @@unique([currency_code, starting_date], map: "currency_exchange_rate_ccy_date_key")
}

/// Business Central Table 277 "Bank Account Posting Group".
model bank_acc_posting_group {
  id            Int        @id @default(autoincrement())
  code          String     @unique
  description   String
  gl_account_id Int
  created_at    String?
  created_by    String?
  gl_account    gl_account @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// A commercial-bank directory (AL Table 52203425) used for payee bank details on payment vouchers.
model external_bank {
  id                   Int                    @id @default(autoincrement())
  code                 String                 @unique
  name                 String
  created_at           String?
  created_by           String?
  external_bank_branch external_bank_branch[]
}

model external_bank_branch {
  id            Int           @id @default(autoincrement())
  bank_code     String
  branch_code   String
  branch_name   String
  external_bank external_bank @relation(fields: [bank_code], references: [code], onDelete: Cascade, onUpdate: NoAction)

  @@unique([bank_code, branch_code], map: "external_bank_branch_key")
}

/// Cash Management module setup — singleton (id is always 1).
model cash_management_setup {
  id                                 Int           @id @default(1)
  receipt_approval_limit             BigInt        @default(0)
  pv_approval_limit                  BigInt        @default(0)
  default_vat_bus_posting_group_code String?
