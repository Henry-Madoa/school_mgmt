/// AL Tab52203636 "Salary Scale Pointers": a notch on a job grade's salary scale — the Basic
/// Pay it carries and, through hr_salary_scale_benefit, the earnings and deductions it confers.
/// An employee placed on a notch inherits both (lib/salaryScales.ts applySalaryScaleToEmployee).
model hr_salary_scale {
  id              Int                       @id @default(autoincrement())
  job_grade_id    Int
  /// The pointer / notch code within the grade — "1", "2" … or "A", "B".
  code            String
  name            String?
  basic_pay_cents BigInt                    @default(0)
  sequence        Int                       @default(0)
  status          String                    @default("ACTIVE")
  created_at      String?
  created_by      String?
  benefits        hr_salary_scale_benefit[]

  @@unique([job_grade_id, code], map: "ux_salary_scale_grade_code")
  @@index([job_grade_id], map: "ix_salary_scale_grade")
}

/// AL Tab52203627 "Income/Deduction Configuration": one earning or deduction a notch confers —
/// a payroll transaction code and its amount per period.
model hr_salary_scale_benefit {
  id                  Int             @id @default(autoincrement())
  salary_scale_id     Int
  transaction_code_id Int
  amount_cents        BigInt          @default(0)
  notes               String?
  salary_scale        hr_salary_scale @relation(fields: [salary_scale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([salary_scale_id, transaction_code_id], map: "ux_salary_scale_benefit")
}

model employee_payroll_transaction {
  id                    Int     @id @default(autoincrement())
  employee_id           Int
  transaction_code_id   Int
  payroll_period_id     Int
  amount_cents          BigInt  @default(0)
  original_amount_cents BigInt?
  balance_cents         BigInt?
  no_of_periods         Int?
  executed_periods      Int     @default(0)
  stopped               Boolean @default(false)
  temporary             Boolean @default(false)
  notes                 String?
  /// The window the line is in force: skipped by a run for a period that ends before start_date
  /// or starts after end_date, and not rolled into a period that starts after end_date.
  start_date            String?
  end_date              String?
  /// Set when the line was conferred by the employee's salary-scale notch; replaced when the
  /// notch changes, kept in step when the notch's benefit amount changes. HR may still stop it.
  salary_scale_id       Int?
  created_at            String?
  created_by            String?

  @@index([employee_id, payroll_period_id], map: "ix_ept_employee_period")
  @@index([payroll_period_id], map: "ix_ept_period")
}

model payroll_p9_line {
