/// ============================================================================================
/// School — academic structure. Nothing about the curriculum is hard-coded: education levels,
/// grade levels, streams, subjects, grading scales and assessment types are rows an
/// administrator maintains under Academics → System Setup. The seed pre-fills the Kenyan CBC
/// structure (PP1–PP2, Grade 1–6, Grade 7–9) as a starting point.
/// ============================================================================================

model academic_year {
  id            Int             @id @default(autoincrement())
  /// e.g. "2026"
  name          String          @unique
  start_date    String
  end_date      String
  is_current    Boolean         @default(false)
  created_at    String?
  created_by    String?
  academic_term academic_term[]
  stream        stream[]
  enrollment    enrollment[]
}

model academic_term {
  id               Int           @id @default(autoincrement())
  academic_year_id Int
  /// e.g. "Term 1"
  name             String
  sort             Int           @default(1)
  start_date       String
  end_date         String
  is_current       Boolean       @default(false)
  academic_year    academic_year @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([academic_year_id, name], map: "ux_academic_term_year_name")
  @@index([academic_year_id], map: "ix_academic_term_year")
}

/// The broad schooling stage — Preparatory, Primary, Junior Secondary ...
model education_level {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  sort        Int           @default(1)
  grade_level grade_level[]
  subject     subject[]
}

/// A single class year — PP1, Grade 4, Grade 8 ...
model grade_level {
  id                 Int                @id @default(autoincrement())
  education_level_id Int
  name               String
  sort               Int                @default(1)
  education_level    education_level    @relation(fields: [education_level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stream             stream[]
  subject_offering   subject_offering[]
  fee_structure      fee_structure[]


  @@unique([education_level_id, name], map: "ux_grade_level_name")
}

/// A class within a grade for one academic year — "Grade 4 East". Students and a class teacher attach here.
model stream {
  id               Int           @id @default(autoincrement())
  grade_level_id   Int
  academic_year_id Int
  name             String
  /// The class teacher — an employee (HR) flagged as teaching staff.
  class_teacher_id Int?
  /// Maximum roll; null = no limit. Placement refuses a full class.
  capacity         Int?
  grade_level      grade_level   @relation(fields: [grade_level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  academic_year    academic_year @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  class_teacher    employee?     @relation("stream_class_teacher", fields: [class_teacher_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([grade_level_id, academic_year_id, name], map: "ux_stream_grade_year_name")
  @@index([academic_year_id], map: "ix_stream_year")
}

model subject {
  id                 Int                @id @default(autoincrement())
  education_level_id Int?
  code               String             @unique
  name               String
  is_core            Boolean            @default(true)
  status             String             @default("ACTIVE")
  education_level    education_level?   @relation(fields: [education_level_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  subject_offering   subject_offering[]
}

/// Which subjects are taught at which grade level.
model subject_offering {
  id             Int         @id @default(autoincrement())
  subject_id     Int
  grade_level_id Int
  subject        subject     @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grade_level    grade_level @relation(fields: [grade_level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([subject_id, grade_level_id], map: "ux_subject_offering")
}

/// An elective a student takes in a year. Core subjects (subject.is_core) need no row — every
/// student in the grade takes them; a non-core subject counts only for students listed here.
model student_subject {
  id               Int    @id @default(autoincrement())
  student_id       Int
  subject_id       Int
  academic_year_id Int
  created_at       String?
  created_by       String?

  @@unique([student_id, subject_id, academic_year_id], map: "ux_student_subject")
  @@index([subject_id, academic_year_id], map: "ix_student_subject_subject_year")
}

/// A named grading / competency scale — "CBC Competency Scale", "KCSE Letter Grades", "IGCSE".
/// Bound to an education level, or the school-wide default when none is.
model grading_scale {
  id                 Int               @id @default(autoincrement())
  name               String            @unique
  is_default         Boolean           @default(false)
  education_level_id Int?
  assessment_band    assessment_band[]
}

/// One band within a grading scale — CBC's Exceeding / Meeting / Approaching / Below Expectations.
model assessment_band {
  id               Int           @id @default(autoincrement())
  grading_scale_id Int
  label            String
  min_score        Float
  max_score        Float
  sort             Int           @default(1)
  color_hex        String        @default("#64748b")
  /// Points the band earns (KCSE A = 12 … E = 1); null on a competency scale. Report cards mean them.
  points           Int?
  grading_scale    grading_scale @relation(fields: [grading_scale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([grading_scale_id], map: "ix_assessment_band_scale")
}

/// A kind of assessment — "Formative Assessment 1", "End of Term Exam".
model assessment_type {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  weight  Float   @default(1)
  is_exam Boolean @default(false)
  sort    Int     @default(1)
}

/// ============================================================================================
/// School — people. A teacher IS an employee (HR owns the record, payroll pays them); this
/// profile adds what only teaching staff carry. A student's fee account is a Receivables
/// customer, so invoices, receipts, aged balances, statements and reminders all come from the
/// finance modules unchanged.
/// ============================================================================================

model teacher_profile {
  id             Int      @id @default(autoincrement())
  employee_id    Int      @unique(map: "ux_teacher_profile_employee")
  tsc_number     String?
  qualification  String?
  specialisation String?
  employee       employee @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Assigns a teacher to teach a subject to a stream for an academic year — drives "My Classes".
model teacher_subject_assignment {
  id               Int @id @default(autoincrement())
  teacher_id       Int
  subject_id       Int
  stream_id        Int
  academic_year_id Int

  @@unique([teacher_id, subject_id, stream_id, academic_year_id], map: "ux_teacher_subject_assignment")
  @@index([stream_id], map: "ix_tsa_stream")
  @@index([teacher_id], map: "ix_tsa_teacher")
}

model guardian {
  id               Int                @id @default(autoincrement())
  full_name        String
  phone            String
  email            String?
  national_id      String?
  relationship     String             @default("Parent")
  occupation       String?
  address          String?
  created_at       String?
  created_by       String?
  student_guardian student_guardian[]
}

model student {
  id                     Int                @id @default(autoincrement())
  admission_no           String             @unique
  first_name             String
  middle_name            String?
  last_name              String
  gender                 String?
  date_of_birth          String?
  birth_certificate_no   String?
  nemis_upi              String?
  /// A Cloudinary public_id (lib/cloudinary.ts) — the student's passport photo.
  photo                  String?
  address                String?
  county_id              Int?
  sub_county_id          Int?
  admission_date         String
  /// ACTIVE | GRADUATED | TRANSFERRED | SUSPENDED | INACTIVE
  status                 String             @default("ACTIVE")
  current_grade_level_id Int?
  current_stream_id      Int?
  /// The Receivables customer that IS this student's fee account (lib/students.ts creates it on admission).
  customer_id            Int?               @unique(map: "ux_student_customer")
  medical_notes          String?
  religion               String?
  /// DAY | BOARDER — decides which fee items apply (fee_item.applies_to).
  boarding_status        String             @default("DAY")
  /// School house / dormitory, free text.
  house                  String?
  created_at             String?
  created_by             String?
  updated_at             String?
  updated_by             String?
  student_guardian       student_guardian[]
  enrollment             enrollment[]

  @@index([current_stream_id], map: "ix_student_stream")
  @@index([current_grade_level_id], map: "ix_student_grade")
  @@index([status], map: "ix_student_status")
}

model student_guardian {
  id          Int      @id @default(autoincrement())
  student_id  Int
  guardian_id Int
  is_primary  Boolean  @default(false)
  student     student  @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guardian    guardian @relation(fields: [guardian_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, guardian_id], map: "ux_student_guardian")
}

/// Which grade/stream a student was in each academic year — written on admission and promotion.
model enrollment {
  id               Int           @id @default(autoincrement())
  student_id       Int
  academic_year_id Int
  grade_level_id   Int
  stream_id        Int?
  /// ACTIVE | PROMOTED | REPEATED | TRANSFERRED_OUT | GRADUATED
  status           String        @default("ACTIVE")
  created_at       String?
  student          student       @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  academic_year    academic_year @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, academic_year_id], map: "ux_enrollment_student_year")
}

/// An optional fee item (transport, lunch, music…) a student has signed up for.
model student_fee_option {
  id          Int    @id @default(autoincrement())
  student_id  Int
  fee_item_id Int
  /// Optional detail — the transport route, the club.
  note        String?
  created_at  String?
  created_by  String?

  @@unique([student_id, fee_item_id], map: "ux_student_fee_option")
}

/// A bursary, scholarship or sibling discount on a student's fees — a percentage or a fixed
/// amount per term, on one fee item or the whole invoice, for a run of terms or indefinitely.
model student_fee_discount {
  id           Int     @id @default(autoincrement())
  student_id   Int
  /// Null = every item on the invoice.
  fee_item_id  Int?
  /// One of the two: a percentage of the item(s), or a fixed amount per term.
  percent      Float   @default(0)
  amount       BigInt  @default(0)
  description  String
  /// Term range (inclusive by term start date); null = open-ended.
  from_term_id Int?
  to_term_id   Int?
  status       String  @default("ACTIVE")
  created_at   String?
  created_by   String?

  @@index([student_id], map: "ix_student_fee_discount_student")
}

/// The admissions pipeline — an enquiry or application before it becomes a student.
/// ENQUIRY | APPLIED | OFFERED | ADMITTED | DECLINED
model admission_application {
  id                   Int     @id @default(autoincrement())
  no                   String  @unique
  first_name           String
  middle_name          String?
  last_name            String
  gender               String?
  date_of_birth        String?
  previous_school      String?
  grade_level_id       Int
  academic_year_id     Int
  boarding_status      String  @default("DAY")
  guardian_name        String
  guardian_phone       String
  guardian_email       String?
  guardian_relationship String @default("Parent")
  notes                String?
  status               String  @default("ENQUIRY")
  /// Set once admitted — the student record the application became.
  student_id           Int?
  applied_at           String
  decided_at           String?
  created_by           String?


  @@index([status], map: "ix_admission_application_status")
}

/// ============================================================================================
/// School services — transport, hostel and library.
/// ============================================================================================

/// A driver's road credentials — the employee (HR record) is the driver; this is what the
/// transport office checks before assigning a bus.
model driver_profile {
  id              Int     @id @default(autoincrement())
  employee_id     Int     @unique(map: "ux_driver_profile_employee")
  licence_no      String
  licence_class   String?
  licence_expiry  String?
  psv_badge_no    String?
  psv_expiry      String?
  notes           String?
  created_at      String?
}

/// A school bus is a fixed asset (the FA register owns cost and depreciation); this is its
/// operating record — registration, seats, the driver and route it is assigned to, papers.
model school_bus {
  id                 Int     @id @default(autoincrement())
  fixed_asset_no     String  @unique(map: "ux_school_bus_asset")
  registration_no    String  @unique(map: "ux_school_bus_reg")
  make_model         String?
  capacity           Int     @default(0)
  driver_employee_id Int?
  route_id           Int?
  /// ACTIVE | WORKSHOP | RETIRED
  status             String  @default("ACTIVE")
  insurance_expiry   String?
  inspection_expiry  String?
  odometer           Int     @default(0)
  notes              String?
  created_at         String?
  created_by         String?

  @@index([route_id], map: "ix_school_bus_route")
}

/// A pick-up / drop-off route. Fare defaults to the TRANSPORT fee item's structure amount; a
/// route may override it with its own termly fare.
model transport_route {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  description  String?
  /// Termly fare in cents; 0 = the fee structure's TRANSPORT amount for the student's grade.
  term_fare    BigInt  @default(0)
  status       String  @default("ACTIVE")
  created_at   String?
}

model transport_stop {
  id          Int     @id @default(autoincrement())
  route_id    Int
  name        String
  pickup_time String?
  dropoff_time String?
  sort        Int     @default(1)

  @@index([route_id], map: "ix_transport_stop_route")
}

/// Which route (and stop) a student rides. Assigning one also opts the student into the
/// TRANSPORT fee item, so the next invoice run bills the fare.
model student_transport {
  id         Int     @id @default(autoincrement())
  student_id Int     @unique(map: "ux_student_transport_student")
  route_id   Int
  stop_id    Int?
  /// BOTH | MORNING | EVENING
  direction  String  @default("BOTH")
  note       String?
  created_at String?
  created_by String?

  @@index([route_id], map: "ix_student_transport_route")
}

/// A work ticket authorises a driver to take a bus out — a route run, a trip, a workshop visit —
/// and records the odometer and fuel on return. No. Series WORK_TICKET.
model bus_work_ticket {
  id                 Int     @id @default(autoincrement())
  no                 String  @unique
  bus_id             Int
  driver_employee_id Int
  route_id           Int?
  date               String
  /// ROUTE_RUN | TRIP | MAINTENANCE
  purpose            String  @default("ROUTE_RUN")
  destination        String?
  odometer_start     Int?
  odometer_end       Int?
  fuel_litres        Float   @default(0)
  fuel_cost          BigInt  @default(0)
  /// OPEN | CLOSED | CANCELLED
  status             String  @default("OPEN")
  remarks            String?
  authorised_by      String?
  created_at         String?
  closed_at          String?

  @@index([bus_id, date], map: "ix_work_ticket_bus_date")
  @@index([driver_employee_id, date], map: "ix_work_ticket_driver_date")
}

/// A hostel (dormitory block) — boys', girls' or mixed — with a warden from HR.
model hostel {
  id                 Int     @id @default(autoincrement())
  code               String  @unique
  name               String
  /// MALE | FEMALE | MIXED
  gender             String  @default("MIXED")
  warden_employee_id Int?
  status             String  @default("ACTIVE")
  notes              String?
}

model hostel_room {
  id        Int    @id @default(autoincrement())
  hostel_id Int
  name      String
  floor     String?
  sort      Int    @default(1)

  @@unique([hostel_id, name], map: "ux_hostel_room")
}

model hostel_bed {
  id      Int    @id @default(autoincrement())
  room_id Int
  label   String
  /// AVAILABLE | OUT_OF_SERVICE (occupancy is a live bed_allocation)
  status  String @default("AVAILABLE")

  @@unique([room_id, label], map: "ux_hostel_bed")
}

/// Who sleeps where. One active allocation per student and per bed at a time.
model bed_allocation {
  id               Int     @id @default(autoincrement())
  bed_id           Int
  student_id       Int
  academic_year_id Int
  from_date        String
  to_date          String?
  /// ACTIVE | VACATED
  status           String  @default("ACTIVE")
  created_by       String?
  created_at       String?

  @@index([student_id, status], map: "ix_bed_allocation_student")
  @@index([bed_id, status], map: "ix_bed_allocation_bed")
}

/// Library rules: how long a loan runs, the daily fine, how many books at once.
model library_setup {
  id                Int    @id @default(1)
  loan_days         Int    @default(14)
  fine_per_day      BigInt @default(0)
  max_loans_student Int    @default(2)
  max_loans_staff   Int    @default(5)
  /// The income account library fines are charged to (a fee-account invoice line).
  fine_gl_account_id Int?
}

/// A title in the catalogue; copies are the physical books.
model library_book {
  id         Int     @id @default(autoincrement())
  isbn       String?
  title      String
  author     String?
  publisher  String?
  year       Int?
  category   String?
  /// Shelf / section.
  location   String?
  status     String  @default("ACTIVE")
  created_at String?

  @@index([title], map: "ix_library_book_title")
}

model library_copy {
  id           Int    @id @default(autoincrement())
  book_id      Int
  accession_no String @unique(map: "ux_library_copy_accession")
  /// AVAILABLE | ON_LOAN | LOST | DAMAGED | WITHDRAWN
  status       String @default("AVAILABLE")
  condition    String?
  added_at     String?

  @@index([book_id], map: "ix_library_copy_book")
}

/// A loan of one copy to a student or a member of staff.
model library_loan {
  id            Int     @id @default(autoincrement())
  copy_id       Int
  student_id    Int?
  employee_id   Int?
  issued_on     String
  due_on        String
  returned_on   String?
  /// ON_LOAN | RETURNED | LOST
  status        String  @default("ON_LOAN")
  fine_amount   BigInt  @default(0)
  /// The posted fee-account invoice the fine was charged to, when it was.
  fine_invoice_no String?
  issued_by     String?
  returned_by   String?
  remarks       String?

  @@index([copy_id, status], map: "ix_library_loan_copy")
  @@index([student_id, status], map: "ix_library_loan_student")
  @@index([employee_id, status], map: "ix_library_loan_employee")
}

/// Discipline cases, medical visits, exeats (leave-outs) and general notes on a student.
/// kind: DISCIPLINE | MEDICAL | EXEAT | NOTE · status: OPEN | CLOSED
model student_incident {
  id           Int     @id @default(autoincrement())
  student_id   Int
  kind         String
  date         String
  title        String
  details      String?
  action_taken String?
  /// Exeats: when the student is expected back; medical: follow-up date.
  follow_up    String?
  status       String  @default("OPEN")
  recorded_by  String?
  recorded_at  String?

  @@index([student_id, date], map: "ix_student_incident_student")
}

/// ============================================================================================
/// School — timetable, attendance, assessment.
/// ============================================================================================

model timetable_slot {
  id               Int     @id @default(autoincrement())
  stream_id        Int
  subject_id       Int
  teacher_id       Int
  academic_year_id Int
  term_id          Int
  /// 1 = Monday … 5 = Friday
  day_of_week      Int
  /// 24h "HH:mm"
  start_time       String
  end_time         String
  room             String?

  @@index([stream_id, day_of_week], map: "ix_timetable_stream_day")
  @@index([teacher_id, day_of_week], map: "ix_timetable_teacher_day")
}

model attendance_record {
  id          Int     @id @default(autoincrement())
  student_id  Int
  stream_id   Int
  date        String
  /// PRESENT | ABSENT | LATE | EXCUSED
  status      String  @default("PRESENT")
  remarks     String?
  recorded_by String?
  recorded_at String?

  @@unique([student_id, date], map: "ux_attendance_student_date")
  @@index([stream_id, date], map: "ix_attendance_stream_date")
}

model assessment_record {
  id                 Int     @id @default(autoincrement())
  student_id         Int
  subject_id         Int
  assessment_type_id Int
  term_id            Int
  academic_year_id   Int
  score              Float
  /// Copied from the matching assessment_band at entry time, so history does not move when the scale is edited.
  competency_label   String?
  remarks            String?
  recorded_by        String?
  recorded_at        String?

  @@unique([student_id, subject_id, assessment_type_id, term_id], map: "ux_assessment_record")
  @@index([student_id, term_id], map: "ix_assessment_student_term")
}

/// A generated / published summary for one student, one term.
model report_card {
  id                    Int     @id @default(autoincrement())
  student_id            Int
  term_id               Int
  academic_year_id      Int
  class_teacher_remarks String?
  principal_remarks     String?
  attendance_summary    String?
  is_published          Boolean @default(false)
  published_at          String?
  published_by          String?

  @@unique([student_id, term_id], map: "ux_report_card_student_term")
}

/// ============================================================================================
/// School — fees. A fee item names the income account it is recognised in; the structure prices
/// it per grade per term; a fee invoice run raises one Sales Invoice per enrolled student (the
/// student's customer), posted through Receivables so the ledger, aged balances and statements
/// are the same ones every other receivable uses. Payments are Receipts of type Customer.
/// ============================================================================================

model fee_item {
  id            Int             @id @default(autoincrement())
  code          String          @unique
  name          String
  /// The fee income G/L account each invoice line credits.
  gl_account_id Int
  status        String          @default("ACTIVE")
  sort          Int             @default(1)
  /// Who the item is billed to: ALL | BOARDER | DAY | OPT_IN (students signed up for it in student_fee_option).
  applies_to    String          @default("ALL")
  gl_account    gl_account      @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fee_structure fee_structure[]
}

/// What a grade pays for a fee item in a term.
model fee_structure {
  id             Int         @id @default(autoincrement())
  grade_level_id Int
  term_id        Int
  fee_item_id    Int
  amount         BigInt      @default(0)
  /// Optional: only boarders / only day scholars ...
  applies_to     String      @default("ALL")
  grade_level    grade_level @relation(fields: [grade_level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fee_item       fee_item    @relation(fields: [fee_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([grade_level_id, term_id, fee_item_id, applies_to], map: "ux_fee_structure")
}

/// One bulk invoicing of a term — which students were billed and the posted invoice each got.
model fee_invoice_run {
  id               Int           @id @default(autoincrement())
  no               String        @unique
  term_id          Int
  academic_year_id Int
  /// Null = every grade with a fee structure for the term.
  grade_level_id   Int?
  posting_date     String
  due_date         String
  /// Instalments: JSON [{ "pct": 60, "due_date": "2026-01-06" }, { "pct": 40, "due_date": "2026-02-15" }]; null = one invoice due on due_date.
  instalments      String?
  /// Open | Posted
  status           String        @default("Open")
  students_billed  Int           @default(0)
  total_amount     BigInt        @default(0)
  created_at       String?
  created_by       String?
  posted_at        String?
  posted_by        String?
  fee_invoice      fee_invoice[]
}

model fee_invoice {
  id                Int             @id @default(autoincrement())
  run_id            Int
  student_id        Int
  customer_id       Int
  term_id           Int
  /// The posted sales invoice number (posted_sales_document.no) — the document the guardian sees.
  posted_invoice_no String
  amount            BigInt          @default(0)
  /// 1-based instalment number when the run was split; 1 for a single invoice.
  instalment_no     Int             @default(1)
  created_at        String?
  run               fee_invoice_run @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, term_id, instalment_no], map: "ux_fee_invoice_student_term")
  @@index([customer_id], map: "ix_fee_invoice_customer")
}

/// ============================================================================================
/// School — communication.
/// ============================================================================================

model announcement {
  id             Int     @id @default(autoincrement())
  title          String
  body           String
  /// ALL | STAFF | TEACHERS | STUDENTS | GUARDIANS | GRADE_LEVEL | STREAM
  audience       String  @default("ALL")
  grade_level_id Int?
  stream_id      Int?
  published_at   String
  expires_at     String?
  created_by     String?
  created_at     String?

  @@index([audience], map: "ix_announcement_audience")
}

