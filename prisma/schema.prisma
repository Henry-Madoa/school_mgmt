  description                  String?
  amount                       BigInt                         @default(0)
  remaining_amount             BigInt                         @default(0)
  original_amount              BigInt                         @default(0)
  amount_lcy                   BigInt                         @default(0)
  remaining_amount_lcy         BigInt                         @default(0)
  original_amount_lcy          BigInt                         @default(0)
  currency_code                String                         @default("KES")
  currency_factor              Float                          @default(1)
  due_date                     String?
  pmt_discount_date            String?
