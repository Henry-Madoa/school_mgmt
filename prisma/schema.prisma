model role {
  id                  Int                   @id @default(autoincrement())
  name                String                @unique
  description         String?
  is_system           Int                   @default(0)
  /// Holders must sign in with an authenticator code (lib/totp.ts).
  require_two_factor  Boolean               @default(false)
  app_user            app_user[]
  permission_set_line permission_set_line[]
  user_permission_set user_permission_set[]
}

/**
 * One line of a Business Central-style Permission Set: a grant of rights on
 * one Object, which is either a database Table (Read/Insert/Modify/Delete)
 * or an application Page (Execute). A role with is_system=1 (System
 * Administrator) has no lines at all — full access is implied directly by
 * the flag, not by a wildcard row here.
 */
model permission_set_line {
  id           Int    @id @default(autoincrement())
  role_id      Int
  object_type  String // 'TABLE' | 'PAGE'
  object_name  String // table name (e.g. 'student') or page code (e.g. 'STUDENTS')
  read_perm    Int    @default(0)
  insert_perm  Int    @default(0)
  modify_perm  Int    @default(0)
  delete_perm  Int    @default(0)
  execute_perm Int    @default(0)
  role         role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, object_type, object_name])
  @@index([role_id])
}

/// A per-user permission override. Defaults to the user's role Permission Set; a row here
/// REPLACES the role's line for that one object, so an admin can restrict or enhance an
/// individual user without changing their role. Same shape as permission_set_line. See
/// lib/userPermissions.ts and loadUserEffectivePermissions() in lib/auth.ts.
model user_permission_line {
  id           Int      @id @default(autoincrement())
  user_id      Int
  object_type  String // 'TABLE' | 'PAGE'
  object_name  String // table name (e.g. 'student') or page code (e.g. 'STUDENTS')
  read_perm    Int      @default(0)
  insert_perm  Int      @default(0)
  modify_perm  Int      @default(0)
  delete_perm  Int      @default(0)
  execute_perm Int      @default(0)
  created_at   String?
  created_by   String?
  user         app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, object_type, object_name])
  @@index([user_id])
}

/// Business Central "User Permission Sets" (Access Control) — a user may be granted more than one
/// Permission Set; effective rights are the union of the primary role (app_user.role_id) plus
/// every set listed here (then user_permission_line overrides on top). See lib/auth.ts.
model user_permission_set {
  id         Int      @id @default(autoincrement())
  user_id    Int
  role_id    Int
  created_at String?
  created_by String?
  user       app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role       role     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id])
  @@index([user_id])
}

