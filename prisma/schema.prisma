  unit_cost     BigInt      @default(0)
  amount        BigInt      @default(0)
  claim         staff_claim @relation(fields: [claim_no], references: [no], onDelete: Cascade, onUpdate: NoAction)
  gl_account    gl_account  @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([claim_no], map: "ix_scll_claim")
}

/// Store & Purchase Requisitions — AL Tab52203515 "Requisition Header". One table
/// carries both requisition types; see lib/requisitions.ts and the migration for the lifecycle.
model requisition {
  no                      String             @id
  /// 'Store Requisition' | 'Purchase Requisition'
  requisition_type        String
  employee_id             Int
  title                   String
  description             String?
  requisition_date        String
  needed_by_date          String?
  expiration_date         String?
  requested_delivery_date String?
  currency_code           String             @default("KES")
  /// The store issuing (store req.) or receiving (purchase req.).
  location_id             Int?
  /// Purchase only — Enum52203430: RFQ | RFP | Direct Procurement | Restricted Tendering | Open Tendering | Low Value Procurement
  procurement_method      String?
  supplier_id             Int?
  /// Open | Pending Approval | Approved | Received
  status                  String             @default("Open")
  decision_reason         String?
  issued                  Boolean            @default(false)
  issued_at               String?
  issued_by               String?
  received                Boolean            @default(false)
  received_at             String?
  received_by             String?
  pr_closed               Boolean            @default(false)
  /// Purchase Order | Direct Receipt of Goods/Services | Rejection
  pr_closed_by            String?
  pr_closed_at            String?
  pr_closed_by_user       String?
  pr_close_reason         String?
  po_generated_directly   Boolean            @default(false)
  po_generated_by         String?
  po_generated_at         String?
  po_number               String?
  global_dimension_1_id   Int?
  global_dimension_2_id   Int?
  created_at              String?
  created_by              String?
  employee                employee           @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location                location?          @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier                vendor?            @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requisition_line        requisition_line[]

  @@index([requisition_type, status], map: "ix_rq_type_status")
  @@index([employee_id], map: "ix_rq_employee")
  @@index([created_by], map: "ix_rq_created_by")
}

/// AL Tab52203516 "Requisition Lines".
model requisition_line {
  id                 Int              @id @default(autoincrement())
  requisition_no     String
  line_no            Int
  /// 'Item' | 'G/L Account' | 'Fixed Asset'
  type               String           @default("Item")
  no                 String
  description        String
  item_id            Int?
  gl_account_id      Int?
  unit_of_measure_id Int?
  quantity           Int              @default(1)
  quantity_approved  Int              @default(0)
  unit_price         BigInt           @default(0)
  amount             BigInt           @default(0)
  location_id        Int?
  quantity_to_issue  Int              @default(0)
  quantity_issued    Int              @default(0)
  issued_at          String?
  issued_by          String?
  /// '' | RFQ | Order | Append to Order — Pag52203556 Requisitions Review
  decision           String           @default("")
  target_no          String?
  processed          Boolean          @default(false)
  order_no           String?
  requisition        requisition      @relation(fields: [requisition_no], references: [no], onDelete: Cascade, onUpdate: NoAction)
  item               item?            @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gl_account         gl_account?      @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit_of_measure    unit_of_measure? @relation(fields: [unit_of_measure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location           location?        @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requisition_no], map: "ix_rql_requisition")
}

/**
 * =============================================================== Inventory
 */
/**
 * Business Central-style Inventory: Locations (multi-location), Units of Measure (with a
 * per-item Base/Purchase/Sales conversion), an Item card with Reorder Point/Quantity/Maximum
 * Inventory and a Costing Method, and Item Journal Lines that post Positive/Negative Adjustments
 * through the same postJournal() engine every other module uses. No AL source exists for this —
 * see lib/itemJournal.ts's header comment for the full design rationale.
 */

/// A stock-keeping location (Business Central Table 14, trimmed). Every Item Ledger Entry and
/// Item Journal Line happens at one of these.
model location {
  id                Int                 @id @default(autoincrement())
  code              String              @unique
  name              String
  address           String?
  status            String              @default("ACTIVE")
  created_at        String?
  created_by        String?
  stockkeeping_unit stockkeeping_unit[]
  item_journal_line item_journal_line[]
  item_ledger_entry item_ledger_entry[]
  requisition       requisition[]
  requisition_line  requisition_line[]
}

/// Business Central Table 204. A global catalogue of units (EACH, BOX, KG, …); an item picks
/// which of these it may be entered in via item_unit_of_measure.
model unit_of_measure {
  id                                                  Int                    @id @default(autoincrement())
  code                                                String                 @unique
  description                                         String
  symbol                                              String?
  created_at                                          String?
  created_by                                          String?
  item_unit_of_measure                                item_unit_of_measure[]
  item_item_base_unit_of_measure_idTounit_of_measure  item[]                 @relation("item_base_uom")
  item_item_purch_unit_of_measure_idTounit_of_measure item[]                 @relation("item_purch_uom")
  item_item_sales_unit_of_measure_idTounit_of_measure item[]                 @relation("item_sales_uom")
  item_journal_line                                   item_journal_line[]
  requisition_line                                    requisition_line[]
}

/// A simplification of Business Central's Inventory Posting Setup + General Posting Setup: one
/// master carrying the two G/L accounts an Item Journal posting moves between — the Inventory
/// account (an asset) and the Adjustment account (an expense/contra the Positive/Negative Adjmt.
/// posts against), the same way cheque_type bundles a clearing G/L account for its own document.
model inventory_posting_group {
  id                      Int        @id @default(autoincrement())
  code                    String     @unique
  description             String
  inventory_gl_account_id Int
  created_at              String?
  created_by              String?
  inventory_gl_account    gl_account @relation("ipg_inventory_gl", fields: [inventory_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item                    item[]
}

/// Business Central's Gen. Prod. Posting Group (the other half of the real General Posting Setup
/// keying — Gen. Bus. Posting Group has no counterpart here, since this module has no
/// customer/vendor-side transactions to combine it with). Every Item also carries one; it names
/// the P&L account a Positive/Negative Adjmt. offsets against. Kept independent of
/// inventory_posting_group exactly as Business Central keeps the two posting-group axes
/// independent — the same G/L account can be reused across item families whose inventory
/// accounts differ, and vice versa — so the subledger (this) and ledger (inventory_posting_group)
/// side of a posting are each configured, and each reconciled, on their own.
model product_posting_group {
  id                       Int         @id @default(autoincrement())
  code                     String      @unique
  description              String
  adjustment_gl_account_id Int
  sales_gl_account_id      Int?
  cogs_gl_account_id       Int?
  created_at               String?
  created_by               String?
  adjustment_gl_account    gl_account  @relation("ppg_adjustment_gl", fields: [adjustment_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales_gl_account         gl_account? @relation("ppg_sales_gl", fields: [sales_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cogs_gl_account          gl_account? @relation("ppg_cogs_gl", fields: [cogs_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item                     item[]
}

/// Business Central Table 27 "Item", trimmed to what a school's back office needs: no locations
/// beyond the multi-location stock split (stockkeeping_unit), no variants/serials/lots, no Item
/// Charges. `inventory` is a maintained roll-up of this item's stockkeeping_unit rows (the same
/// cached-running-total idea as gl_account.balance). Reordering fields are this item's defaults —
/// a stockkeeping_unit row may override them per location.
model item {
  id                         Int                     @id @default(autoincrement())
  no                         String                  @unique
  description                String
  description_2              String?
  base_unit_of_measure_id    Int
  purch_unit_of_measure_id   Int?
  sales_unit_of_measure_id   Int?
  inventory_posting_group_id Int
  product_posting_group_id   Int
  /// 'FIFO' | 'LIFO' | 'Average' | 'Standard' | 'Specific' — Business Central's own five.
  costing_method             String                  @default("FIFO")
  unit_cost                  BigInt                  @default(0)
  unit_price                 BigInt                  @default(0)
  inventory                  Int                     @default(0)
  /// 'Fixed Reorder Qty.' | 'Maximum Qty.' — feeds lib/itemJournal.ts's calculateReplenishment().
  reordering_policy          String                  @default("Fixed Reorder Qty.")
  reorder_point              Int                     @default(0)
  reorder_quantity           Int                     @default(0)
  maximum_inventory          Int                     @default(0)
  status                     String                  @default("ACTIVE")
  created_at                 String?
  created_by                 String?
  base_unit_of_measure       unit_of_measure         @relation("item_base_uom", fields: [base_unit_of_measure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purch_unit_of_measure      unit_of_measure?        @relation("item_purch_uom", fields: [purch_unit_of_measure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales_unit_of_measure      unit_of_measure?        @relation("item_sales_uom", fields: [sales_unit_of_measure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_posting_group    inventory_posting_group @relation(fields: [inventory_posting_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_posting_group      product_posting_group   @relation(fields: [product_posting_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item_unit_of_measure       item_unit_of_measure[]
  stockkeeping_unit          stockkeeping_unit[]
  item_journal_line          item_journal_line[]
  item_ledger_entry          item_ledger_entry[]
  requisition_line           requisition_line[]

  @@index([status], map: "ix_item_status")
}

/// Business Central Table 5404. Which units an item may be entered in, and each one's conversion
/// factor to that item's Base UoM (BC never converts UoM-to-UoM, only ever via Base) — see
/// lib/unitOfMeasureConversion.ts.
model item_unit_of_measure {
  id                      Int             @id @default(autoincrement())
  item_id                 Int
  unit_of_measure_id      Int
  qty_per_unit_of_measure Int             @default(1)
  item                    item            @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit_of_measure         unit_of_measure @relation(fields: [unit_of_measure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([item_id, unit_of_measure_id])
}

/// Business Central Table 5700 "Stockkeeping Unit" — per item+location qty-on-hand, with an
/// optional per-location override of the item's Reordering Policy/Reorder Point/Reorder
/// Quantity/Maximum Inventory (null = inherit the item's own default). Auto-created the first
/// time an item posts at a location — see postItemJournalLine() in lib/itemJournal.ts.
model stockkeeping_unit {
  id                Int      @id @default(autoincrement())
  item_id           Int
  location_id       Int
  reordering_policy String?
  reorder_point     Int?
  reorder_quantity  Int?
  maximum_inventory Int?
  inventory         Int      @default(0)
  item              item     @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  location          location @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([item_id, location_id])
}

/// Business Central Table 83 "Item Journal Line", scoped to Positive/Negative Adjmt. only.
/// Lifecycle Open -> Pending Approval -> Approved -> Processed.
/// `journal_id` and `applies_to_entry_id` are plain reference columns (no FK constraint), the
/// see lib/itemJournal.ts.
model item_journal_line {
  id                      Int                 @id @default(autoincrement())
  no                      String              @unique
  posting_date            String
  /// 'Positive Adjmt.' | 'Negative Adjmt.'
  entry_type              String
  item_id                 Int
  location_id             Int
  description             String?
  unit_of_measure_id      Int
  /// Snapshot of item_unit_of_measure.qty_per_unit_of_measure at entry time.
  qty_per_unit_of_measure Int                 @default(1)
  /// Entered in unit_of_measure_id's unit.
  quantity                Int                 @default(0)
  /// quantity * qty_per_unit_of_measure — what actually moves stock, in the item's Base UoM.
  base_quantity           Int                 @default(0)
  /// Specific costing only — the one open lot (item_ledger_entry.id) this outbound line applies
  /// against. No FK constraint (see model comment).
  applies_to_entry_id     Int?
  unit_cost               BigInt              @default(0)
  amount                  BigInt              @default(0)
  status                  String              @default("Open")
  decision_reason         String?
  posted                  Boolean             @default(false)
  /// The posted G/L journal, once posted. No FK constraint (see model comment).
  journal_id              Int?
  /// The store requisition line this Negative Adjmt. issued (lib/requisitions.ts). No FK constraint.
  requisition_line_id     Int?
  global_dimension_1_id   Int?
  global_dimension_2_id   Int?
  created_at              String?
  created_by              String?
  posted_at               String?
  posted_by               String?
  item                    item                @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location                location            @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit_of_measure         unit_of_measure     @relation(fields: [unit_of_measure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  itemLedgerEntries       item_ledger_entry[]

  @@index([item_id], map: "ix_ijl_item")
  @@index([location_id], map: "ix_ijl_location")
  @@index([status], map: "ix_ijl_status")
  @@index([created_by], map: "ix_ijl_created_by")
  @@index([posting_date], map: "ix_ijl_posting_date")
}

/// Business Central Table 32 "Item Ledger Entry" — the posted, immutable stock movement. An
/// inbound (Positive Adjmt.) entry is a costed lot: `remaining_quantity`/`open` track how much of
/// it is still unconsumed. An outbound (Negative Adjmt.) entry's `unit_cost` is whatever the
/// costing engine determined (see lib/itemJournal.ts) and leaves remaining_quantity/open at 0/false.
model item_ledger_entry {
  id                                                                                 Int                      @id @default(autoincrement())
  item_id                                                                            Int
  location_id                                                                        Int
  posting_date                                                                       String
  entry_type                                                                         String
  document_no                                                                        String
  /// Signed, in the item's Base UoM: positive for an inbound lot, negative for an outbound entry.
  quantity                                                                           Int
  /// Inbound lots only — how much of this lot has not yet been applied to an outbound entry.
  remaining_quantity                                                                 Int                      @default(0)
  /// Inbound lots only — true while remaining_quantity > 0.
  open                                                                               Boolean                  @default(false)
  unit_cost                                                                          BigInt                   @default(0)
  amount                                                                             BigInt                   @default(0)
  /// Null for an outbound entry written by a sales shipment/invoice (lib/salesDocuments.ts)
  /// rather than the Item Journal.
  item_journal_line_id                                                               Int?
  created_at                                                                         String?
  item                                                                               item                     @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location                                                                           location                 @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item_journal_line                                                                  item_journal_line?       @relation(fields: [item_journal_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item_application_entry_item_application_entry_outbound_entry_idToitem_ledger_entry item_application_entry[] @relation("iae_outbound")
  item_application_entry_item_application_entry_inbound_entry_idToitem_ledger_entry  item_application_entry[] @relation("iae_inbound")

  @@index([item_id], map: "ix_ile_item")
  @@index([location_id], map: "ix_ile_location")
}

/// Business Central Table 339 "Item Application Entry" — which inbound lot(s) an outbound entry
/// consumed, and how much of each. Written by the costing engine for FIFO/LIFO/Average/Specific
/// (Standard skips lot application entirely — see lib/itemJournal.ts).
model item_application_entry {
  id                Int               @id @default(autoincrement())
  outbound_entry_id Int
  inbound_entry_id  Int
  quantity          Int
  posting_date      String
  created_at        String?
  outbound_entry    item_ledger_entry @relation("iae_outbound", fields: [outbound_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inbound_entry     item_ledger_entry @relation("iae_inbound", fields: [inbound_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([outbound_entry_id], map: "ix_iae_outbound")
  @@index([inbound_entry_id], map: "ix_iae_inbound")
}

/// Business Central Table 5628 "FA Class".
model fa_class {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String
  status      String  @default("ACTIVE")
  created_at  String?
  created_by  String?
}

/// Business Central Table 5629 "FA Subclass".
model fa_subclass {
  id            Int     @id @default(autoincrement())
  code          String  @unique
  description   String
  fa_class_code String?
  status        String  @default("ACTIVE")
  created_at    String?
  created_by    String?
}

/// Business Central Table 5643 "FA Location" — where an asset physically sits. Separate from the
/// Inventory location master.
model fa_location {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String
  status      String  @default("ACTIVE")
  created_at  String?
  created_by  String?
}

/// Business Central Table 5611 "Depreciation Book". This port always integrates to the G/L.
model depreciation_book {
  id                            Int                    @id @default(autoincrement())
  code                          String                 @unique
  description                   String
  g_l_integration               Int                    @default(1)
  default_final_rounding_amount BigInt                 @default(0)
  use_rounding_in_periodic_depr Int                    @default(0)
  created_at                    String?
  created_by                    String?
  fa_depreciation_book          fa_depreciation_book[]
  fa_journal_line               fa_journal_line[]
  fa_ledger_entry               fa_ledger_entry[]
}

/// Business Central Table 5606 "FA Posting Group" (trimmed — book-value / proceeds-on-disposal
/// accounts are netted into the gains / losses accounts here). Every FA G/L posting resolves its
/// debit and credit from the asset's posting group. See lib/faJournal.ts.
model fa_posting_group {
  id                              Int                    @id @default(autoincrement())
  code                            String                 @unique
  description                     String
  acquisition_cost_account_id     Int
  accum_depreciation_account_id   Int
  depreciation_expense_account_id Int
  write_down_expense_account_id   Int
  appreciation_account_id         Int
  maintenance_expense_account_id  Int
  gains_acc_on_disposal_id        Int
  losses_acc_on_disposal_id       Int
  created_at                      String?
  created_by                      String?
  acquisition_cost_account        gl_account             @relation("fapg_acquisition_cost", fields: [acquisition_cost_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accum_depreciation_account      gl_account             @relation("fapg_accum_depreciation", fields: [accum_depreciation_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  depreciation_expense_account    gl_account             @relation("fapg_depreciation_expense", fields: [depreciation_expense_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  write_down_expense_account      gl_account             @relation("fapg_write_down_expense", fields: [write_down_expense_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appreciation_account            gl_account             @relation("fapg_appreciation", fields: [appreciation_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenance_expense_account     gl_account             @relation("fapg_maintenance_expense", fields: [maintenance_expense_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gains_acc_on_disposal           gl_account             @relation("fapg_gains_on_disposal", fields: [gains_acc_on_disposal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  losses_acc_on_disposal          gl_account             @relation("fapg_losses_on_disposal", fields: [losses_acc_on_disposal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fa_depreciation_book            fa_depreciation_book[]
}

/// Business Central Table 5603 "FA Setup" — singleton (id is always 1). FA Nos. / FA Journal
/// Nos. are handled by the No. Series module, not stored here.
model fa_setup {
  id                             Int     @id @default(1)
  default_depreciation_book_code String?
  default_fa_posting_group_code  String?
  allow_fa_posting_from          String?
  allow_fa_posting_to            String?
  updated_at                     String?
  updated_by                     String?
}

/// Business Central Table 5616 "Maintenance" — the master list of maintenance / service types.
model maintenance {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String
  status      String  @default("ACTIVE")
  created_at  String?
  created_by  String?
}

/// Business Central Table 5600 "Fixed Asset". acquisition_date / disposal_date are stamped by
/// posting, never entered.
model fixed_asset {
  id                       Int                       @id @default(autoincrement())
  no                       String                    @unique
  description              String
  description_2            String?
  fa_class_code            String?
  fa_subclass_code         String?
  fa_location_code         String?
  responsible_employee     String?
  serial_no                String?
  vendor_name              String?
  asset_tag                String?
  global_dimension_1_id    Int?
  global_dimension_2_id    Int?
  blocked                  Int                       @default(0)
  inactive                 Int                       @default(0)
  acquisition_date         String?
  disposal_date            String?
  created_at               String?
  created_by               String?
  global_dimension_1_value global_dimension_1_value? @relation(fields: [global_dimension_1_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  global_dimension_2_value global_dimension_2_value? @relation(fields: [global_dimension_2_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fa_depreciation_book     fa_depreciation_book[]
  fa_journal_line          fa_journal_line[]
  fa_ledger_entry          fa_ledger_entry[]

  @@index([fa_class_code], map: "ix_fa_class")
  @@index([fa_location_code], map: "ix_fa_location")
}

/// Business Central Table 5612 "FA Depreciation Book" — one row per asset + book, carrying the
/// depreciation parameters and a maintained roll-up of the ledger amounts. See
/// lib/fixedAssetDepreciation.ts.
model fa_depreciation_book {
  id                          Int               @id @default(autoincrement())
  fixed_asset_id              Int
  depreciation_book_code      String
  fa_posting_group_code       String
  /// 'Straight-Line' | 'Declining-Balance 1' | 'DB1/SL' | 'Manual'
  depreciation_method         String            @default("Straight-Line")
  depreciation_starting_date  String?
  depreciation_ending_date    String?
  no_of_depreciation_years    Float?
  straight_line_pct           Float             @default(0)
  declining_balance_pct       Float             @default(0)
  fixed_depr_amount           BigInt            @default(0)
  salvage_value               BigInt            @default(0)
  last_depreciation_date      String?
  /// 'Net' | 'Gross'
  disposal_calculation_method String            @default("Net")
  acquisition_cost            BigInt            @default(0)
  accumulated_depreciation    BigInt            @default(0)
  write_down_amount           BigInt            @default(0)
  appreciation_amount         BigInt            @default(0)
  book_value                  BigInt            @default(0)
  proceeds_on_disposal        BigInt            @default(0)
  gain_loss_on_disposal       BigInt            @default(0)
  maintenance_total           BigInt            @default(0)
  disposed                    Int               @default(0)
  fixed_asset                 fixed_asset       @relation(fields: [fixed_asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  depreciation_book           depreciation_book @relation(fields: [depreciation_book_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  fa_posting_group            fa_posting_group  @relation(fields: [fa_posting_group_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fixed_asset_id, depreciation_book_code])
  @@index([depreciation_book_code], map: "ix_fadb_book")
}

/// The FA Journal — a maker-checker document, same lifecycle shape as item_journal_line
/// (Open -> Pending Approval -> Approved -> Processed). journal_id carries no FK, matching the
/// loose convention item_journal_line.journal_id already uses.
model fa_journal_line {
  id                         Int               @id @default(autoincrement())
  no                         String            @unique
  posting_date               String
  document_no                String?
  fixed_asset_id             Int
  depreciation_book_code     String
  /// 'Acquisition Cost' | 'Depreciation' | 'Write-Down' | 'Appreciation' | 'Disposal' | 'Maintenance'
  fa_posting_type            String
  amount                     BigInt            @default(0)
  balancing_gl_account_id    Int?
  maintenance_code           String?
  depr_until_fa_posting_date Int               @default(0)
  no_of_depreciation_days    Int?
  description                String?
  /// 'MANUAL' | 'CALCULATE_DEPRECIATION'
  source                     String            @default("MANUAL")
  status                     String            @default("Open")
  decision_reason            String?
  posted                     Boolean           @default(false)
  journal_id                 Int?
  created_at                 String?
  created_by                 String?
  posted_at                  String?
  posted_by                  String?
  fixed_asset                fixed_asset       @relation(fields: [fixed_asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  depreciation_book          depreciation_book @relation(fields: [depreciation_book_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  balancing_gl_account       gl_account?       @relation(fields: [balancing_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fa_ledger_entry            fa_ledger_entry[]

  @@index([fixed_asset_id], map: "ix_faj_asset")
  @@index([status], map: "ix_faj_status")
  @@index([created_by], map: "ix_faj_created_by")
  @@index([posting_date], map: "ix_faj_posting_date")
}

/// Business Central Table 5601 "FA Ledger Entry" — the posted, immutable FA movement. amount is
/// signed (negative for Depreciation / Write-Down, positive for Acquisition / Appreciation).
model fa_ledger_entry {
  id                      Int               @id @default(autoincrement())
  fixed_asset_id          Int
  depreciation_book_code  String
  fa_posting_date         String
  fa_posting_type         String
  document_no             String
  description             String?
  amount                  BigInt            @default(0)
  no_of_depreciation_days Int?
  journal_id              Int?
  fa_journal_line_id      Int?
  part_of_book_value      Int               @default(1)
  maintenance_code        String?
  reversed                Int               @default(0)
  created_at              String?
  fixed_asset             fixed_asset       @relation(fields: [fixed_asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  depreciation_book       depreciation_book @relation(fields: [depreciation_book_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  fa_journal_line         fa_journal_line?  @relation(fields: [fa_journal_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fixed_asset_id, depreciation_book_code], map: "ix_fale_asset_book")
  @@index([fa_posting_date], map: "ix_fale_date")
  @@index([fa_posting_type], map: "ix_fale_type")
}

