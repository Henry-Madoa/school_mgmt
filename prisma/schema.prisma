  code        String  @unique
  description String  @default("")
  /// 'VAT' | 'WHT'
  tax_type    String  @default("VAT")
  created_at  String?
  created_by  String?
}

/// Business Central Table 325 "VAT Posting Setup" (Bus. x Prod.). tax_account is the input-VAT
/// account for VAT rows, the tax-payable account for WHT rows.
model vat_posting_setup {
  id                          Int         @id @default(autoincrement())
  vat_bus_posting_group_code  String
  vat_prod_posting_group_code String
  /// 'VAT' | 'WHT'
  tax_type                    String      @default("VAT")
  vat_pct                     Float       @default(0)
  /// 'Normal' | 'Zero VAT' | 'Exempt'
  vat_calculation_type        String      @default("Normal")
